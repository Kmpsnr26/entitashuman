NODE_ENV=development

DATABASE_URL=postgresql://nara:YOUR_DATABASE_PASSWORD@127.0.0.1:5432/nara

BIND_HOST=127.0.0.1
AUTH_PORT=4100
ALECORE_AI_PORT=4200

PUBLIC_AUTH_ORIGIN=http://127.0.0.1:4100
PUBLIC_ALECORE_AI_ORIGIN=http://127.0.0.1:4200

AUTH_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ALECORE_AI_SESSION_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
TICKET_PEPPER=GENERATE_A_THIRD_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# AleCore AI AI Gateway
# Keep provider credentials server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
AI_PROVIDER_ORDER=openai,gemini,anthropic,compatible
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=2048

# Optional additional providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional OpenAI-compatible provider.
# All three COMPAT_* values are required together.
COMPAT_PROVIDER_ID=compatible
COMPAT_API_BASE_URL=
COMPAT_API_KEY=
COMPAT_MODEL=

# Example automatic fallback order:
# AI_PROVIDER_ORDER=openai,gemini,anthropic,compatible

# Provider circuit breaker
AI_BREAKER_FAILURE_THRESHOLD=3
AI_BREAKER_COOLDOWN_MS=60000

# Optional Google Drive memory backup.
# Keep all credentials server-side. All four values are required together.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
