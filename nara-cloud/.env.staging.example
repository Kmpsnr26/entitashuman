# Staging template only. Copy values into the server secret store/environment.
# Never commit populated credentials.
NODE_ENV=production
BIND_HOST=127.0.0.1
AUTH_PORT=4100
NARA_PORT=4200

PUBLIC_AUTH_ORIGIN=https://staging-auth.aleprinting.my.id
PUBLIC_NARA_ORIGIN=https://staging-nara.aleprinting.my.id

DATABASE_URL=
AUTH_SESSION_SECRET=
NARA_SESSION_SECRET=
TICKET_PEPPER=

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Google Drive backup OAuth (server-side only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Backup encryption key/reference. Prefer a secret-store reference where supported.
BACKUP_ENCRYPTION_KEY=
