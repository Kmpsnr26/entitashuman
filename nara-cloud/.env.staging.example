# Staging template only. Copy values into the server secret store/environment.
# Never commit populated credentials.
NODE_ENV=production
BIND_HOST=127.0.0.1
AUTH_PORT=4100
NARA_PORT=4200

PUBLIC_AUTH_ORIGIN=https://staging-auth.aleprinting.my.id
PUBLIC_NARA_ORIGIN=https://staging-nara.aleprinting.my.id

DATABASE_URL=
AUTH_SESSION_SECRET=
NARA_SESSION_SECRET=
TICKET_PEPPER=

# Optional providers: leave these omitted until configured with non-empty values.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional Google Drive memory backup (server-side only).
# Supply all four together; these are the names consumed by the runtime.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# Backup encryption key/reference. Prefer a secret-store reference where supported.
BACKUP_ENCRYPTION_KEY=

# PostgreSQL CLI backup connection (separate from the application's DATABASE_URL).
# Use a protected password file; never put a password in a command argument.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=
PGUSER=
# PGPASSFILE=/protected/path/to/pgpass
