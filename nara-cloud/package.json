{
  "name": "nara-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:auth": "tsx watch src/apps/authServer.ts",
    "dev:nara": "tsx watch src/apps/naraServer.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "create-owner": "tsx src/scripts/createOwner.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test tests/security.test.ts tests/source-security.test.ts tests/schema-source.test.ts",
    "test:db": "node --import tsx --test tests/ticket-db.test.ts",
    "verify": "npm run build && npm run test:unit",
    "start:auth": "node dist/apps/authServer.js",
    "start:nara": "node dist/apps/naraServer.js"
  },
  "dependencies": {
    "argon2": "latest",
    "connect-pg-simple": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "express-session": "latest",
    "helmet": "latest",
    "pg": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "latest",
    "@types/express": "latest",
    "@types/express-session": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
