{
  "name": "humanale-god-egine",
  "private": true,
  "version": "2.4.2",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron desktop/main.cjs",
    "verify": "npm test && npm run build",
    "package:desktop": "install-electron --no && node package-desktop.mjs",
    "package:installer": "npx --yes electron-builder@26.16.1 --win nsis --x64 --publish never",
    "smoke:terminal": "node scripts/terminal-smoke.mjs",
    "nara:studio": "node nara-core/studio/server.mjs",
    "test:nara": "node --test tests/nara-core.test.mjs tests/nara-studio.test.mjs tests/nara-voice.test.mjs",
    "smoke:neural-live": "electron scripts/nara-neural-live-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.4.3"
  },
  "main": "desktop/main.cjs",
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "three": "0.186.0"
  }
}
